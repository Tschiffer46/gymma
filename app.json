{
  "expo": {
    "name": "Gymma",
    "slug": "gymma",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gymma",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/7531d681-3148-493d-ae86-2718c7eb810f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "nu.vadskavi.gymma",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#131316"
      },
      "package": "nu.vadskavi.gymma"
    },
    "plugins": [
      "expo-router",
      "./plugins/withPrivacyManifest",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#131316"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7531d681-3148-493d-ae86-2718c7eb810f"
      }
    },
    "owner": "tschiffer46"
  }
}
